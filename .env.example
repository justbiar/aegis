# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key. Get one free at https://alchemy.com → your Starknet
# app → API key. The URL prefix is built in src/lib/networks.ts; paste ONLY the
# key here. Read on the server only — the browser reaches the chain through
# /api/rpc/<network>, so the key never enters the client bundle.
# NEXT_PUBLIC_PROVIDER_URL is still read as a fallback for older deployments.
PROVIDER_URL=your_alchemy_key_here

# (Optional) Your echo/anonymizer helper deployed on Sepolia — enables the Echo
# action there. Leave as 0x0 if not deployed; you can deploy one from the Echo tab
# in the app and paste the returned address here.
NEXT_PUBLIC_STRK20_ECHO_HELPER_SEPOLIA=0x0

# GitHub OAuth — proves a claimant owns the repo that leaked. Create an OAuth
# App at https://github.com/settings/applications/new with callback URL
# http://localhost:3000/api/auth/callback/github, then paste its values below.
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret
# Generate with: openssl rand -hex 32
AUTH_SECRET=your_random_auth_secret

# Safe/vault account — where rescued funds land, and later signs the transfer
# back out to a verified claimant. NEVER commit the real value; .env.local is
# gitignored.
SAFE_WALLET_ADDRESS=0x0255A3A68885dEC1C836dd0f72C553b87F1A51849D726777C8434b77b02b8E89
SAFE_WALLET_PRIVATE_KEY=your_safe_wallet_private_key_here

# (Optional) Mainnet safe/vault account — same role as SAFE_WALLET_ADDRESS
# above but on mainnet. Leave unset to keep the scanner Sepolia-only: with no
# value here, checkFunds() still reads mainnet balances (for display) but
# rescueFunds() never signs or broadcasts on mainnet. Reuses
# NEXT_PUBLIC_PROVIDER_URL for its RPC — no separate mainnet key needed,
# same pattern as src/utils/constants.ts. Setting this is real money: the
# very next page load (local or deployed) auto-scans the registry and
# sweeps any funded leaked key it finds, no confirmation prompt.
SAFE_WALLET_ADDRESS_MAINNET=

# (Optional) Addresses whose money was never a victim's — the vault's own test
# wallets, a faucet, anything that funded a planted leak. Money traced to these
# is not claimable by anyone: sweeping it back recovered nothing. Comma
# separated. On-chain there is no way to tell "we funded this drill" from "the
# owner topped up their own wallet", so this list is the only way Aegis knows.
NON_VICTIM_FUNDERS=

# (Optional) GitHub login that, holding the safe wallet, sees the payout queue.
# Public username; defaults to justbiar when unset.
NEXT_PUBLIC_ADMIN_GITHUB_LOGIN=

# (Optional) Raises GitHub's rate limit for the pull-request pass. A classic
# token with no scopes is enough — it reads public repositories only.
GITHUB_TOKEN=

# (Optional) Only needed off Vercel. next-auth works out its own callback URL
# on Vercel and cannot elsewhere, so on Netlify, Cloudflare Pages or any other
# host set this to the deployed origin and point the GitHub OAuth App's
# callback at <origin>/api/auth/callback/github.
AUTH_URL=

# Upstash Redis (https://upstash.com → your database → REST API). Holds the
# rescue ledger, claims, epochs, the hot list and the last scan's result.
# Without these the site still renders, but it remembers nothing between
# visits and the scanner has nowhere to publish what it found.
#
# The scanner needs these too: it runs in CI now, not in the web host, so the
# same two values go in the repository's Actions secrets alongside
# PROVIDER_URL and the safe-wallet addresses. See .github/workflows/scan.yml.
KV_REST_API_URL=
KV_REST_API_TOKEN=
